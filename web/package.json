{
  "name": "guitar-tuner-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "codegen:note-math": "node ../scripts/generate-note-math.mjs",
    "codegen:check": "node ../scripts/generate-note-math.mjs --check",
    "dev": "npm run codegen:check && npm run build:wasm && vite",
    "build": "npm run codegen:check && npm run build:wasm && vue-tsc -b && vite build",
    "build:tauri": "npm run codegen:check && npm run build:wasm && vue-tsc -b && vite build --base ./",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "test": "npm run codegen:check && vitest run src tests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:core:legacy": "node ./scripts/test-core.mjs",
    "preview": "vite preview",
    "tauri:dev": "cd ../desktop && npm run tauri dev",
    "tauri:build": "npm run build:tauri && cd ../desktop && npm run tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-store": "^2.4.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.8"
  }
}
