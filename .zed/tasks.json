[
  {
    "label": "Run: Web",
    "command": "npm",
    "args": ["run", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT/web",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: Tauri desktop",
    "command": "npm",
    "args": ["run", "tauri:dev"],
    "cwd": "$ZED_WORKTREE_ROOT/web",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: egui native",
    "command": "cargo",
    "args": ["run", "-p", "guitar-tuner-egui"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
